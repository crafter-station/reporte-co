# ── Database (Supabase Cloud Postgres) ─────────────────────────────────────
# Supabase project → Connect → ORMs/Drizzle → Connection pooler string (6543).
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-1-us-west-2.pooler.supabase.com:6543/postgres"

# ── Supabase Cloud (Realtime + client) ─────────────────────────────────────
# Project → Settings → API. Use the ANON (JWT) key — the sb_publishable_ key
# does NOT work with Supabase Realtime.
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_OR_ANON_KEY="your-anon-jwt-key"

# ── Kapso / WhatsApp Cloud API ─────────────────────────────────────────────
# Get these from https://kapso.ai (connect a WhatsApp number, copy API key + phone id)
KAPSO_API_KEY=""
KAPSO_BASE_URL="https://api.kapso.ai/meta/whatsapp"
KAPSO_PHONE_NUMBER_ID=""
# App secret used to verify inbound webhook signatures (X-Hub-Signature-256)
WHATSAPP_APP_SECRET=""
# Arbitrary token you choose; echo it back during the webhook GET handshake
WHATSAPP_VERIFY_TOKEN="mc-verify-change-me"

# ── Privacy / security ─────────────────────────────────────────────────────
# Pepper for hashing reporter phone numbers. Generate: openssl rand -hex 32
REPORTER_HASH_SECRET="change-me-openssl-rand-hex-32"

# ── Photo uploads (optional) ───────────────────────────────────────────────
# Vercel Blob token (Vercel → Storage → your Blob store → .env tab). Server-only.
# Enables photo evidence + moderator publishing. Without it the upload UI is
# hidden. `vercel env pull` brings this down automatically.
BLOB_READ_WRITE_TOKEN=""

# ── Moderator gate (MVP — replace with Supabase Auth later) ─────────────────
MODERATOR_PASSWORD="change-me"
# Generate: openssl rand -hex 32
MODERATOR_SESSION_SECRET="change-me-openssl-rand-hex-32"
# Number of independent moderator confirmations needed before a report publishes
PUBLISH_THRESHOLD="1"
# Set "true" to skip moderation and publish reports on submit. PII is still
# scrubbed and coordinates coarsened, but no human reviews them first. Keep
# "false" for the privacy-first posture; "true" is for demos/low-risk use.
AUTO_PUBLISH="false"

# ── Map (Mapbox) ───────────────────────────────────────────────────────────
# Public access token (pk.…) from account.mapbox.com → Tokens. REQUIRED.
NEXT_PUBLIC_MAPBOX_TOKEN="pk.your-mapbox-public-token"

# ── Optional ───────────────────────────────────────────────────────────────
# Override the basemap (defaults to mapbox://styles/mapbox/dark-v11).
# e.g. mapbox://styles/mapbox/light-v11 or .../satellite-streets-v12
# NEXT_PUBLIC_MAP_STYLE_URL=""
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"
